rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsPlayer(playerId) {
      return signedIn() && (playerId == request.auth.uid || playerId.endsWith('_' + request.auth.uid));
    }

    function validRecord(version) {
      return request.resource.data is map
        && version is string
        && version.size() >= 1
        && version.size() <= 60
        && request.resource.data.courseVersion == version
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timeMs is int
        && request.resource.data.timeMs >= 0
        && request.resource.data.timeMs <= 86400000
        && request.resource.data.falls is int
        && request.resource.data.falls >= 0
        && request.resource.data.falls <= 10000
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 10000
        && request.resource.data.checkpoints is int
        && request.resource.data.checkpoints >= 0
        && request.resource.data.checkpoints <= 14
        && request.resource.data.deaths is int
        && request.resource.data.deaths >= 0
        && request.resource.data.deaths <= 100000
        && request.resource.data.stage is int
        && request.resource.data.stage >= 1
        && request.resource.data.stage <= 15
        && request.resource.data.completed is bool
        && request.resource.data.scoreMs is int
        && request.resource.data.scoreMs >= 0
        && request.resource.data.scoreMs <= 116400000
        && request.resource.data.scoreMs == request.resource.data.timeMs + request.resource.data.falls * 3000;
    }

    match /players/{playerId} {
      allow read: if ownsPlayer(playerId) || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.nickname == resource.data.nickname;
      allow delete: if signedIn() && (playerId == request.auth.uid || resource.data.uid == request.auth.uid);
    }

    match /players/{playerId}/progress/{version} {
      allow read: if ownsPlayer(playerId) || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if ownsPlayer(playerId) && request.resource.data.uid == request.auth.uid;
    }

    match /rankings/{version}/records/{playerId} {
      allow read, list: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && validRecord(version);
      allow update: if signedIn() && request.resource.data.uid == request.auth.uid && validRecord(version);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
